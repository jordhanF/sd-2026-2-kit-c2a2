# Copie para .env:  cp .env.example .env
# A chave da API NUNCA vai no codigo - so por variavel de ambiente (item 3 do
# roteiro do edital). O .env esta no .gitignore.

# Deixe LLM_API_KEY vazia para usar o MODO SIMULADO (funciona offline).
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini

# Resiliencia da chamada ao LLM: tempo-limite e retentativa.
LLM_TIMEOUT=20
TENTATIVAS_LLM=3

# Onde cada servico encontra os outros.
URL_INGESTAO=http://localhost:8001
URL_RECUPERACAO=http://localhost:8002
URL_GERACAO=http://localhost:8003

# Fila e persistencia.
REDIS_URL=redis://localhost:6379/0
CAMINHO_DADOS=dados
MAX_TENTATIVAS=3

# INFO ou DEBUG.
LOG_NIVEL=INFO
